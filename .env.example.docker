# Required: JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Required: OpenAI API key
OPENAI_API_KEY=sk-...

# Required: Cohere API key
COHERE_API_KEY=...

# Optional: Restrict registration to specific email domains (comma-separated)
# ALLOWED_DOMAINS=trialbase.com,clinicaltrials.gov
