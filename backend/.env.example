# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trialbase

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed email domains for registration (empty = allow all)
# ALLOWED_DOMAINS=trialbase.com,clinicaltrials.gov

# OpenAI
OPENAI_API_KEY=sk-...

# Cohere
COHERE_API_KEY=...

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional overrides
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# LLM_MODEL=gpt-4o-mini
# COHERE_RERANK_MODEL=rerank-v3.5
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440
# VECTOR_COLLECTION_NAME=documents
# LOG_LEVEL=INFO
# LOG_JSON=true
# APP_NAME=knowledge-base
# DEBUG=false
